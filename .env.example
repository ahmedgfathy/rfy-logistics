# ==========================================================
# MARSA Logistics — environment template
# Copy to `.env` (never commit the real file):
#   cp .env.example .env
# ==========================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=marsa
POSTGRES_PASSWORD=marsa_dev_password_change_me
POSTGRES_DB=marsa_logistics
POSTGRES_PORT=5432

# ---------- Backend ----------
# Must be at least 32 characters in production.
JWT_SECRET=dev-only-secret-change-me-32-characters-min
JWT_EXPIRES_IN=8h
# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Public URL of the site (used in emails / absolute links)
PUBLIC_SITE_URL=http://localhost:5173

# ---------- Bootstrap administrator ----------
# Used only by the seed script. Change before first production boot.
ADMIN_EMAIL=admin@marsa-demo.local
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Operations Administrator

# ---------- Seeding ----------
# true  -> inserts clearly-labelled DEMO shipment records + demo news articles
# false -> only the administrator account and service catalogue are created
SEED_DEMO_DATA=true

# ---------- Uploads ----------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=8

# ---------- Frontend ----------
VITE_API_BASE_URL=/api/v1
VITE_SITE_URL=http://localhost:5173

# ---------- pgAdmin (optional, profile: tools) ----------
PGADMIN_DEFAULT_EMAIL=admin@marsa-demo.local
PGADMIN_DEFAULT_PASSWORD=ChangeMe!2026
PGADMIN_PORT=5050

# ---------- Vercel deployment (see docs/VERCEL_DEPLOYMENT.md) ----------
# Use Neon's POOLED connection string (host contains "-pooler") so serverless
# invocations do not exhaust the database connection limit.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
# NODE_ENV=production
# SEED_DEMO_DATA=false
# UPLOAD_DIR=/tmp/uploads
# VITE_SITE_URL=https://your-project.vercel.app
# CORS_ORIGIN=https://your-project.vercel.app
# PUBLIC_SITE_URL=https://your-project.vercel.app
#
# Vercel Blob keeps quote/CV uploads durable. Connecting the Blob store to the
# project injects BLOB_STORE_ID + VERCEL_OIDC_TOKEN automatically. If you use a
# static token instead, set BLOB_READ_WRITE_TOKEN.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
