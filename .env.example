# ==========================================================
# MARSA Logistics — environment template
# Copy to `.env` (never commit the real file):
#   cp .env.example .env
# ==========================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=marsa
POSTGRES_PASSWORD=marsa_dev_password_change_me
POSTGRES_DB=marsa_logistics
POSTGRES_PORT=5432

# ---------- Backend ----------
# Must be at least 32 characters in production.
JWT_SECRET=dev-only-secret-change-me-32-characters-min
JWT_EXPIRES_IN=8h
# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Public URL of the site (used in emails / absolute links)
PUBLIC_SITE_URL=http://localhost:5173

# ---------- Bootstrap administrator ----------
# Used only by the seed script. Change before first production boot.
ADMIN_EMAIL=admin@marsa-demo.local
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Operations Administrator

# ---------- Seeding ----------
# true  -> inserts clearly-labelled DEMO shipment records in development
# false -> seeds only reference data and the administrator account
SEED_DEMO_DATA=false
# true -> run the idempotent reference/admin seed after migrations on startup
# false -> skip seeding after migrations
RUN_SEED=true

# ---------- Uploads ----------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=8
# auto uses Blob when credentials exist and local disk otherwise.
# Vercel production requires Blob; local disk is rejected there even if selected explicitly.
STORAGE_DRIVER=auto

# ---------- Frontend ----------
VITE_API_BASE_URL=/api/v1
VITE_SITE_URL=http://localhost:5173

# ---------- pgAdmin (optional, profile: tools) ----------
PGADMIN_DEFAULT_EMAIL=admin@marsa-demo.local
PGADMIN_DEFAULT_PASSWORD=ChangeMe!2026
PGADMIN_PORT=5050

# ---------- Vercel deployment (see docs/VERCEL_DEPLOYMENT.md) ----------
# Runtime (serverless) should use a POOLED connection string so invocations do
# not exhaust the database connection limit. The app prefers DATABASE_URL_POOLED
# when present; otherwise it uses DATABASE_URL. DIRECT_URL is mandatory for
# Prisma schema validation and must use a plain PostgreSQL migration endpoint.
# Neon:    host contains "-pooler"
# Prisma:  host is "pooled.db.prisma.io" (Vercel injects DATABASE_URL_POOLED)
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# DATABASE_URL_POOLED=postgresql://user:password@pooled-host/db?sslmode=require
# DIRECT_URL=postgresql://user:password@direct-host/db?sslmode=require
# NODE_ENV=production
# RUN_SEED=false
# SEED_DEMO_DATA=false
# UPLOAD_DIR=/tmp/uploads
# VITE_SITE_URL=https://your-project.vercel.app
# CORS_ORIGIN=https://your-project.vercel.app
# PUBLIC_SITE_URL=https://your-project.vercel.app
#
# Vercel Blob keeps quote/CV uploads durable. Connecting the Blob store to the
# project injects BLOB_STORE_ID + VERCEL_OIDC_TOKEN automatically. If you use a
# static token instead, set BLOB_READ_WRITE_TOKEN.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
