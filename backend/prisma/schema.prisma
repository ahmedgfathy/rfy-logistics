// MARSA Logistics — PostgreSQL schema
// Normalised, extensible and audit-friendly.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum FreightMode {
  SEA
  AIR
  ROAD
  RAIL
  MULTIMODAL
}

enum QuoteStatus {
  NEW
  UNDER_REVIEW
  QUOTATION_SENT
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum ShipmentStatus {
  BOOKED
  ORIGIN_PICKUP
  DEPARTED_ORIGIN
  IN_TRANSIT
  CUSTOMS_CLEARANCE
  OUT_FOR_DELIVERY
  DELIVERED
  DELAYED
  CANCELLED
}

enum ApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
}

model User {
  id            String           @id @default(uuid()) @db.Uuid
  email         String           @unique
  passwordHash  String
  name          String
  role          Role             @default(EDITOR)
  isActive      Boolean          @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  auditLogs     AuditLog[]
  accessRoles   UserAccessRole[]
  branches      UserBranch[]
  assignedTasks Task[]

  @@index([role])
}

model Permission {
  id          String                 @id @default(uuid()) @db.Uuid
  key         String                 @unique
  description String
  createdAt   DateTime               @default(now())
  roles       AccessRolePermission[]
}

model CompanySetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Service {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  icon       String   @default("Ship")
  titleEn    String
  titleAr    String
  excerptEn  String   @db.Text
  excerptAr  String   @db.Text
  bodyEn     String   @db.Text
  bodyAr     String   @db.Text
  featuresEn String[]
  featuresAr String[]
  position   Int      @default(0)
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, position])
}

model QuoteRequest {
  id                 String            @id @default(uuid()) @db.Uuid
  reference          String            @unique
  fullName           String
  companyName        String?
  email              String
  phone              String
  originCountry      String
  originCity         String
  destinationCountry String
  destinationCity    String
  shipmentType       String
  freightMode        FreightMode
  cargoDescription   String            @db.Text
  cargoWeightKg      Decimal?          @db.Decimal(12, 2)
  cargoVolumeCbm     Decimal?          @db.Decimal(12, 3)
  packageCount       Int?
  containerType      String?
  incoterms          String?
  expectedShipDate   DateTime?
  additionalNotes    String?           @db.Text
  status             QuoteStatus       @default(NEW)
  adminNotes         String?           @db.Text
  locale             String            @default("en")
  sourceIp           String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  attachments        QuoteAttachment[]
  convertedQuote     Quote?            @relation("LeadQuote")

  @@index([status, createdAt])
  @@index([email])
}

model QuoteAttachment {
  id         String       @id @default(uuid()) @db.Uuid
  quoteId    String       @db.Uuid
  quote      QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fileName   String
  storedName String       @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime     @default(now())

  @@index([quoteId])
}

model ContactMessage {
  id         String        @id @default(uuid()) @db.Uuid
  fullName   String
  email      String
  phone      String?
  company    String?
  subject    String
  message    String        @db.Text
  status     ContactStatus @default(NEW)
  adminNotes String?       @db.Text
  locale     String        @default("en")
  sourceIp   String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
}

model Shipment {
  id                  String             @id @default(uuid()) @db.Uuid
  companyId           String?            @db.Uuid
  customerId          String?            @db.Uuid
  bookingId           String?            @db.Uuid
  trackingNumber      String             @unique
  reference           String?
  status              ShipmentStatus     @default(BOOKED)
  mode                FreightMode        @default(SEA)
  carrier             String?
  vesselOrFlight      String?
  containerType       String?
  originPort          String
  destinationPort     String
  pieces              Int?
  weightKg            Decimal?           @db.Decimal(12, 2)
  etd                 DateTime?
  eta                 DateTime?
  deliveredAt         DateTime?
  lastLocation        String?
  isDemo              Boolean            @default(false)
  isPublic            Boolean            @default(false)
  publicTrackingToken String?            @unique
  version             Int                @default(1)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  company             Company?           @relation(fields: [companyId], references: [id])
  customer            BusinessPartner?   @relation(fields: [customerId], references: [id])
  booking             Booking?           @relation(fields: [bookingId], references: [id])
  events              ShipmentEvent[]
  packages            CargoPackage[]
  containers          Container[]
  vendors             ShipmentVendor[]
  customsFiles        CustomsFile[]
  documents           ShipmentDocument[]
  invoices            Invoice[]
  bills               Bill[]

  @@index([status])
  @@index([createdAt])
  @@index([companyId, status])
  @@index([customerId])
}

model ShipmentEvent {
  id          String         @id @default(uuid()) @db.Uuid
  shipmentId  String         @db.Uuid
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  location    String?
  description String         @db.Text
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  @@index([shipmentId, occurredAt])
}

model NewsArticle {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  titleEn     String
  titleAr     String
  excerptEn   String    @db.Text
  excerptAr   String    @db.Text
  bodyEn      String    @db.Text
  bodyAr      String    @db.Text
  coverImage  String?
  category    String    @default("Insights")
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  author      String    @default("MARSA Logistics")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model Testimonial {
  id         String   @id @default(uuid()) @db.Uuid
  authorName String
  authorRole String?
  company    String?
  quoteEn    String   @db.Text
  quoteAr    String   @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Partner {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  logoUrl    String?
  websiteUrl String?
  isApproved Boolean  @default(false)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
}

model JobApplication {
  id           String            @id @default(uuid()) @db.Uuid
  fullName     String
  email        String
  phone        String
  position     String
  experience   String?
  coverLetter  String            @db.Text
  cvFileName   String?
  cvStoredName String?           @unique
  status       ApplicationStatus @default(NEW)
  locale       String            @default("en")
  createdAt    DateTime          @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

enum PartnerType {
  CUSTOMER
  VENDOR
  BOTH
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
}

enum SalesQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum BookingStatus {
  CONFIRMED
  OPERATIONAL
  COMPLETED
  CANCELLED
}

enum ChargeType {
  FREIGHT
  ORIGIN
  DESTINATION
  CUSTOMS
  DUTY
  TAX
  INSURANCE
  HANDLING
  STORAGE
  OTHER
}

enum CustomsDirection {
  IMPORT
  EXPORT
  TRANSIT
}

enum CustomsFileStatus {
  DRAFT
  ACI_PENDING
  ACI_ACCEPTED
  DECLARATION_DRAFT
  UNDER_REVIEW
  INSPECTION
  PAYMENT_PENDING
  RELEASED
  CLOSED
  CANCELLED
}

enum AciStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum DeclarationStatus {
  DRAFT
  SUBMITTED
  ASSESSED
  PAID
  RELEASED
  CANCELLED
}

enum DocumentCategory {
  COMMERCIAL_INVOICE
  PACKING_LIST
  BILL_OF_LADING
  AIR_WAYBILL
  CERTIFICATE_OF_ORIGIN
  ACI_RECEIPT
  CUSTOMS_DECLARATION
  DUTY_PAYMENT
  INSPECTION_REPORT
  INSURANCE
  OTHER
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

enum StorageDriver {
  BLOB
  LOCAL
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalType {
  SALES
  PURCHASE
  CASH
  BANK
  GENERAL
  CUSTOMS
  OPENING
}

enum EntryStatus {
  DRAFT
  POSTED
  VOID
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum BillStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentDirection {
  RECEIPT
  PAYMENT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum PaymentStatus {
  DRAFT
  POSTED
  VOID
}

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  LOCKED
}

enum ReconciliationStatus {
  DRAFT
  REVIEWED
  APPROVED
}

enum MatchStatus {
  MATCHED
  UNMATCHED
}

model Company {
  id              String              @id @default(uuid()) @db.Uuid
  code            String              @unique
  nameEn          String
  nameAr          String
  legalNameEn     String
  legalNameAr     String
  taxNumber       String?
  baseCurrency    String              @default("EGP")
  countryCode     String              @default("EG")
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  branches        Branch[]
  partners        BusinessPartner[]
  roles           AccessRole[]
  chargeItems     ChargeItem[]
  quotes          Quote[]
  bookings        Booking[]
  shipments       Shipment[]
  documents       Document[]
  tasks           Task[]
  customsFiles    CustomsFile[]
  accounts        Account[]
  journals        Journal[]
  fiscalYears     FiscalYear[]
  taxCodes        TaxCode[]
  exchangeRates   ExchangeRate[]
  invoices        Invoice[]
  bills           Bill[]
  bankAccounts    BankAccount[]
  payments        Payment[]
  reconciliations Reconciliation[]
  sequences       NumberSequence[]
  idempotency     IdempotencyRecord[]
  integrations    IntegrationRecord[]
  JournalEntry    JournalEntry[]
}

model Branch {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @db.Uuid
  code      String
  nameEn    String
  nameAr    String
  address   String?
  taxNumber String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  company   Company      @relation(fields: [companyId], references: [id])
  users     UserBranch[]
  quotes    Quote[]
  bookings  Booking[]
  invoices  Invoice[]
  bills     Bill[]

  @@unique([companyId, code])
}

model BusinessPartner {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          String           @db.Uuid
  code               String
  type               PartnerType
  status             PartnerStatus    @default(ACTIVE)
  nameEn             String
  nameAr             String?
  legalName          String?
  taxNumber          String?
  registrationNumber String?
  email              String?
  phone              String?
  website            String?
  billingAddress     String?
  shippingAddress    String?
  countryCode        String           @default("EG")
  currency           String           @default("EGP")
  creditLimit        Decimal?         @db.Decimal(18, 2)
  paymentTermDays    Int              @default(0)
  notes              String?          @db.Text
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  company            Company          @relation(fields: [companyId], references: [id])
  contacts           PartnerContact[]
  addresses          PartnerAddress[]
  quotes             Quote[]
  bookings           Booking[]
  shipments          Shipment[]
  shipmentVendors    ShipmentVendor[]
  invoices           Invoice[]
  bills              Bill[]
  payments           Payment[]
  journalLines       JournalLine[]    @relation("JournalPartner")
  customsAsImporter  CustomsFile[]    @relation("CustomsImporter")
  customsAsBroker    CustomsFile[]    @relation("CustomsBroker")

  @@unique([companyId, code])
  @@index([companyId, type, status])
  @@index([companyId, nameEn])
}

model PartnerContact {
  id        String          @id @default(uuid()) @db.Uuid
  partnerId String          @db.Uuid
  name      String
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())
  partner   BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model PartnerAddress {
  id          String          @id @default(uuid()) @db.Uuid
  partnerId   String          @db.Uuid
  label       String
  address     String
  city        String?
  countryCode String          @default("EG")
  isDefault   Boolean         @default(false)
  partner     BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model AccessRole {
  id          String                 @id @default(uuid()) @db.Uuid
  companyId   String                 @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  company     Company                @relation(fields: [companyId], references: [id])
  permissions AccessRolePermission[]
  users       UserAccessRole[]

  @@unique([companyId, code])
}

model AccessRolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserAccessRole {
  userId String     @db.Uuid
  roleId String     @db.Uuid
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserBranch {
  userId   String @db.Uuid
  branchId String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model ChargeItem {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  code               String
  nameEn             String
  nameAr             String?
  type               ChargeType
  defaultPrice       Decimal?            @db.Decimal(18, 2)
  currency           String              @default("EGP")
  taxCodeId          String?             @db.Uuid
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  company            Company             @relation(fields: [companyId], references: [id])
  taxCode            TaxCode?            @relation(fields: [taxCodeId], references: [id])
  quoteLines         QuoteLine[]
  invoiceLines       InvoiceLine[]
  billLines          BillLine[]
  declarationCharges DeclarationCharge[]

  @@unique([companyId, code])
}

model Quote {
  id                   String           @id @default(uuid()) @db.Uuid
  companyId            String           @db.Uuid
  branchId             String?          @db.Uuid
  number               String
  customerId           String           @db.Uuid
  sourceQuoteRequestId String?          @unique @db.Uuid
  status               SalesQuoteStatus @default(DRAFT)
  currency             String           @default("EGP")
  exchangeRate         Decimal          @default(1) @db.Decimal(18, 8)
  validUntil           DateTime?
  sentAt               DateTime?
  acceptedAt           DateTime?
  convertedAt          DateTime?
  notes                String?          @db.Text
  terms                String?          @db.Text
  createdById          String?
  version              Int              @default(1)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  company              Company          @relation(fields: [companyId], references: [id])
  branch               Branch?          @relation(fields: [branchId], references: [id])
  customer             BusinessPartner  @relation(fields: [customerId], references: [id])
  sourceQuoteRequest   QuoteRequest?    @relation("LeadQuote", fields: [sourceQuoteRequestId], references: [id])
  lines                QuoteLine[]
  bookings             Booking[]
  invoices             Invoice[]
  QuoteDocument        QuoteDocument[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
}

model QuoteLine {
  id              String      @id @default(uuid()) @db.Uuid
  quoteId         String      @db.Uuid
  position        Int         @default(0)
  chargeItemId    String?     @db.Uuid
  descriptionEn   String
  descriptionAr   String?
  quantity        Decimal     @default(1) @db.Decimal(18, 3)
  unitPrice       Decimal     @db.Decimal(18, 2)
  discountPercent Decimal     @default(0) @db.Decimal(9, 4)
  taxCodeId       String?     @db.Uuid
  taxPercent      Decimal     @default(0) @db.Decimal(9, 4)
  subtotal        Decimal     @db.Decimal(18, 2)
  discount        Decimal     @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(18, 2)
  total           Decimal     @db.Decimal(18, 2)
  quote           Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  chargeItem      ChargeItem? @relation(fields: [chargeItemId], references: [id])
  taxCode         TaxCode?    @relation(fields: [taxCodeId], references: [id])
}

model Booking {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @db.Uuid
  branchId       String?         @db.Uuid
  number         String
  quoteId        String?         @db.Uuid
  customerId     String          @db.Uuid
  status         BookingStatus   @default(CONFIRMED)
  mode           FreightMode
  origin         String
  destination    String
  carrier        String?
  vesselOrFlight String?
  incoterms      String?
  etd            DateTime?
  eta            DateTime?
  notes          String?         @db.Text
  createdById    String?
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  company        Company         @relation(fields: [companyId], references: [id])
  branch         Branch?         @relation(fields: [branchId], references: [id])
  customer       BusinessPartner @relation(fields: [customerId], references: [id])
  quote          Quote?          @relation(fields: [quoteId], references: [id])
  shipments      Shipment[]
  invoices       Invoice[]
  bills          Bill[]

  @@unique([companyId, number])
}

model CargoPackage {
  id            String   @id @default(uuid()) @db.Uuid
  shipmentId    String   @db.Uuid
  packageNumber String
  description   String
  packageType   String?
  quantity      Int      @default(1)
  lengthCm      Decimal? @db.Decimal(12, 2)
  widthCm       Decimal? @db.Decimal(12, 2)
  heightCm      Decimal? @db.Decimal(12, 2)
  weightKg      Decimal? @db.Decimal(12, 3)
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, packageNumber])
}

model Container {
  id              String   @id @default(uuid()) @db.Uuid
  shipmentId      String   @db.Uuid
  containerNumber String   @unique
  equipmentType   String?
  sealNumber      String?
  volumeCbm       Decimal? @db.Decimal(12, 3)
  weightKg        Decimal? @db.Decimal(12, 3)
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model ShipmentVendor {
  id         String          @id @default(uuid()) @db.Uuid
  shipmentId String          @db.Uuid
  vendorId   String          @db.Uuid
  service    String
  amount     Decimal         @db.Decimal(18, 2)
  currency   String          @default("EGP")
  status     String          @default("QUOTED")
  reference  String?
  notes      String?         @db.Text
  shipment   Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  vendor     BusinessPartner @relation(fields: [vendorId], references: [id])

  @@index([shipmentId])
}

model Document {
  id            String                @id @default(uuid()) @db.Uuid
  companyId     String                @db.Uuid
  category      DocumentCategory
  fileName      String
  storedName    String                @unique
  mimeType      String
  sizeBytes     Int
  sha256        String?
  version       Int                   @default(1)
  storageDriver StorageDriver         @default(LOCAL)
  status        DocumentStatus        @default(ACTIVE)
  uploadedById  String?
  createdAt     DateTime              @default(now())
  archivedAt    DateTime?
  company       Company               @relation(fields: [companyId], references: [id])
  shipments     ShipmentDocument[]
  declarations  DeclarationDocument[]
  quotes        QuoteDocument[]

  @@index([companyId, category, createdAt])
}

model ShipmentDocument {
  shipmentId String   @db.Uuid
  documentId String   @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([shipmentId, documentId])
}

model DeclarationDocument {
  declarationId String             @db.Uuid
  documentId    String             @db.Uuid
  declaration   CustomsDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  document      Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([declarationId, documentId])
}

model QuoteDocument {
  quoteId    String   @db.Uuid
  documentId String   @db.Uuid
  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([quoteId, documentId])
}

model Task {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @db.Uuid
  title        String
  description  String?      @db.Text
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  assignedToId String?      @db.Uuid
  relatedType  String
  relatedId    String       @db.Uuid
  createdById  String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  company      Company      @relation(fields: [companyId], references: [id])
  assignedTo   User?        @relation(fields: [assignedToId], references: [id])

  @@index([companyId, status, dueDate])
  @@index([relatedType, relatedId])
}

model HsCode {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique
  descriptionEn    String
  descriptionAr    String?
  defaultDutyRate  Decimal           @default(0) @db.Decimal(9, 4)
  defaultTaxRate   Decimal           @default(0) @db.Decimal(9, 4)
  isActive         Boolean           @default(true)
  effectiveFrom    DateTime          @default(now())
  effectiveTo      DateTime?
  dutyRules        DutyRule[]
  declarationLines DeclarationLine[]
}

model DutyRule {
  id            String           @id @default(uuid()) @db.Uuid
  hsCodeId      String           @db.Uuid
  direction     CustomsDirection
  originCountry String           @default("EG")
  dutyPercent   Decimal          @db.Decimal(9, 4)
  taxPercent    Decimal          @default(0) @db.Decimal(9, 4)
  effectiveFrom DateTime         @default(now())
  effectiveTo   DateTime?
  hsCode        HsCode           @relation(fields: [hsCodeId], references: [id], onDelete: Cascade)

  @@index([hsCodeId, direction, effectiveFrom])
}

model CustomsFile {
  id            String               @id @default(uuid()) @db.Uuid
  companyId     String               @db.Uuid
  number        String
  shipmentId    String               @db.Uuid
  importerId    String               @db.Uuid
  brokerId      String?              @db.Uuid
  direction     CustomsDirection
  portCode      String
  customsOffice String?
  status        CustomsFileStatus    @default(DRAFT)
  openedAt      DateTime             @default(now())
  closedAt      DateTime?
  notes         String?              @db.Text
  assignedToId  String?
  version       Int                  @default(1)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  company       Company              @relation(fields: [companyId], references: [id])
  shipment      Shipment             @relation(fields: [shipmentId], references: [id])
  importer      BusinessPartner      @relation("CustomsImporter", fields: [importerId], references: [id])
  broker        BusinessPartner?     @relation("CustomsBroker", fields: [brokerId], references: [id])
