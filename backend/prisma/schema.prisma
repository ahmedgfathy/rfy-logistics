// MARSA Logistics — PostgreSQL schema
// Normalised, extensible and audit-friendly.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum FreightMode {
  SEA
  AIR
  ROAD
  RAIL
  MULTIMODAL
}

enum QuoteStatus {
  NEW
  UNDER_REVIEW
  QUOTATION_SENT
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum ShipmentStatus {
  BOOKED
  ORIGIN_PICKUP
  DEPARTED_ORIGIN
  IN_TRANSIT
  CUSTOMS_CLEARANCE
  OUT_FOR_DELIVERY
  DELIVERED
  DELAYED
  CANCELLED
}

enum ApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    AuditLog[]

  @@index([role])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now())
}

model CompanySetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  icon        String   @default("Ship")
  titleEn     String
  titleAr     String
  excerptEn   String   @db.Text
  excerptAr   String   @db.Text
  bodyEn      String   @db.Text
  bodyAr      String   @db.Text
  featuresEn  String[]
  featuresAr  String[]
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, position])
}

model QuoteRequest {
  id               String          @id @default(uuid()) @db.Uuid
  reference        String          @unique
  fullName         String
  companyName      String?
  email            String
  phone            String
  originCountry    String
  originCity       String
  destinationCountry String
  destinationCity  String
  shipmentType     String
  freightMode      FreightMode
  cargoDescription String          @db.Text
  cargoWeightKg    Decimal?        @db.Decimal(12, 2)
  cargoVolumeCbm   Decimal?        @db.Decimal(12, 3)
  packageCount     Int?
  containerType    String?
  incoterms        String?
  expectedShipDate DateTime?
  additionalNotes  String?         @db.Text
  status           QuoteStatus     @default(NEW)
  adminNotes       String?         @db.Text
  locale           String          @default("en")
  sourceIp         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  attachments      QuoteAttachment[]

  @@index([status, createdAt])
  @@index([email])
}

model QuoteAttachment {
  id         String       @id @default(uuid()) @db.Uuid
  quoteId    String       @db.Uuid
  quote      QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fileName   String
  storedName String       @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime     @default(now())

  @@index([quoteId])
}

model ContactMessage {
  id        String        @id @default(uuid()) @db.Uuid
  fullName  String
  email     String
  phone     String?
  company   String?
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  adminNotes String?      @db.Text
  locale    String        @default("en")
  sourceIp  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  trackingNumber String         @unique
  reference      String?
  status         ShipmentStatus @default(BOOKED)
  mode           FreightMode    @default(SEA)
  carrier        String?
  vesselOrFlight String?
  containerType  String?
  originPort     String
  destinationPort String
  pieces         Int?
  weightKg       Decimal?       @db.Decimal(12, 2)
  etd            DateTime?
  eta            DateTime?
  deliveredAt    DateTime?
  lastLocation   String?
  isDemo         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  events         ShipmentEvent[]

  @@index([status])
  @@index([createdAt])
}

model ShipmentEvent {
  id          String         @id @default(uuid()) @db.Uuid
  shipmentId  String         @db.Uuid
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  location    String?
  description String         @db.Text
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  @@index([shipmentId, occurredAt])
}

model NewsArticle {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  titleEn     String
  titleAr     String
  excerptEn   String    @db.Text
  excerptAr   String    @db.Text
  bodyEn      String    @db.Text
  bodyAr      String    @db.Text
  coverImage  String?
  category    String    @default("Insights")
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  author      String    @default("MARSA Logistics")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model Testimonial {
  id          String   @id @default(uuid()) @db.Uuid
  authorName  String
  authorRole  String?
  company     String?
  quoteEn     String   @db.Text
  quoteAr     String   @db.Text
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Partner {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  logoUrl    String?
  websiteUrl String?
  isApproved Boolean  @default(false)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
}

model JobApplication {
  id          String            @id @default(uuid()) @db.Uuid
  fullName    String
  email       String
  phone       String
  position    String
  experience  String?
  coverLetter String            @db.Text
  cvFileName  String?
  cvStoredName String?          @unique
  status      ApplicationStatus @default(NEW)
  locale      String            @default("en")
  createdAt   DateTime          @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}
