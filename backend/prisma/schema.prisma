  weightKg        Decimal?           @db.Decimal(18, 3)
  customsValue    Decimal            @db.Decimal(18, 2)
  currency        String             @default("USD")
  exchangeRate    Decimal            @default(1) @db.Decimal(18, 8)
  cifValueEgp     Decimal            @db.Decimal(18, 2)
  dutyRatePercent Decimal            @db.Decimal(9, 4)
  dutyAmount      Decimal            @db.Decimal(18, 2)
  taxRatePercent  Decimal            @default(0) @db.Decimal(9, 4)
  taxAmount       Decimal            @default(0) @db.Decimal(18, 2)
  otherAmount     Decimal            @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal            @db.Decimal(18, 2)
  declaration     CustomsDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  hsCode          HsCode?            @relation(fields: [hsCodeId], references: [id])

