  @@unique([companyId, number])
  @@index([shipmentId, status])
}

model AciFiling {
  id                  String      @id @default(uuid()) @db.Uuid
  customsFileId       String      @db.Uuid
  acidNumber          String?     @unique
  nafezaRequestNumber String?
  nafezaItemNumber    String?
  status              AciStatus   @default(DRAFT)
  submittedAt         DateTime?
  respondedAt         DateTime?
  responseReference   String?
  payloadHash         String?
  notes               String?     @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  customsFile         CustomsFile @relation(fields: [customsFileId], references: [id], onDelete: Cascade)

  @@index([customsFileId, status])
}

model CustomsDeclaration {
  id                String                @id @default(uuid()) @db.Uuid
  customsFileId     String                @db.Uuid
  number            String
  declarationNumber String?
  status            DeclarationStatus     @default(DRAFT)
  direction         CustomsDirection
  declarationDate   DateTime?
  assessedDate      DateTime?
  releasedDate      DateTime?
  currency          String                @default("EGP")
  totalCifEgp       Decimal               @default(0) @db.Decimal(18, 2)
  totalDuty         Decimal               @default(0) @db.Decimal(18, 2)
  totalTax          Decimal               @default(0) @db.Decimal(18, 2)
  totalFees         Decimal               @default(0) @db.Decimal(18, 2)
  totalPayable      Decimal               @default(0) @db.Decimal(18, 2)
  paidAmount        Decimal               @default(0) @db.Decimal(18, 2)
  balance           Decimal               @default(0) @db.Decimal(18, 2)
  version           Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  customsFile       CustomsFile           @relation(fields: [customsFileId], references: [id], onDelete: Cascade)
  lines             DeclarationLine[]
  charges           DeclarationCharge[]
  documents         DeclarationDocument[]
  bills             Bill[]

  @@unique([customsFileId, number])
  @@unique([customsFileId, declarationNumber])
}

model DeclarationLine {
  id              String             @id @default(uuid()) @db.Uuid
  declarationId   String             @db.Uuid
  lineNumber      Int
  hsCodeId        String?            @db.Uuid
  hsCodeSnapshot  String
