model ExchangeRate {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  currency  String
  rateDate  DateTime @db.Date
  rate      Decimal  @db.Decimal(18, 8)
  source    String   @default("MANUAL")
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, currency, rateDate])
}

model Invoice {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String              @db.Uuid
  branchId      String?             @db.Uuid
  number        String
  customerId    String              @db.Uuid
  quoteId       String?             @db.Uuid
  bookingId     String?             @db.Uuid
  shipmentId    String?             @db.Uuid
  status        InvoiceStatus       @default(DRAFT)
  issueDate     DateTime?
  dueDate       DateTime?
  currency      String              @default("EGP")
  exchangeRate  Decimal             @default(1) @db.Decimal(18, 8)
  subtotal      Decimal             @default(0) @db.Decimal(18, 2)
  discount      Decimal             @default(0) @db.Decimal(18, 2)
  taxAmount     Decimal             @default(0) @db.Decimal(18, 2)
  total         Decimal             @default(0) @db.Decimal(18, 2)
  paidAmount    Decimal             @default(0) @db.Decimal(18, 2)
  balance       Decimal             @default(0) @db.Decimal(18, 2)
  notes         String?             @db.Text
  terms         String?             @db.Text
  postedEntryId String?             @unique @db.Uuid
  createdById   String?
  version       Int                 @default(1)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  company       Company             @relation(fields: [companyId], references: [id])
  branch        Branch?             @relation(fields: [branchId], references: [id])
  customer      BusinessPartner     @relation(fields: [customerId], references: [id])
  quote         Quote?              @relation(fields: [quoteId], references: [id])
  booking       Booking?            @relation(fields: [bookingId], references: [id])
  shipment      Shipment?           @relation(fields: [shipmentId], references: [id])
  lines         InvoiceLine[]
  allocations   PaymentAllocation[]
  journalLines  JournalLine[]       @relation("JournalInvoice")
  postedEntry   JournalEntry?       @relation("InvoiceEntry", fields: [postedEntryId], references: [id])

  @@unique([companyId, number])
  @@index([companyId, status, dueDate])
}

model InvoiceLine {
  id              String      @id @default(uuid()) @db.Uuid
  invoiceId       String      @db.Uuid
  position        Int         @default(0)
  chargeItemId    String?     @db.Uuid
  description     String
  quantity        Decimal     @default(1) @db.Decimal(18, 3)
  unitPrice       Decimal     @db.Decimal(18, 2)
  discountPercent Decimal     @default(0) @db.Decimal(9, 4)
  taxCodeId       String?     @db.Uuid
  taxPercent      Decimal     @default(0) @db.Decimal(9, 4)
  subtotal        Decimal     @db.Decimal(18, 2)
  discount        Decimal     @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(18, 2)
  total           Decimal     @db.Decimal(18, 2)
  invoice         Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  chargeItem      ChargeItem? @relation(fields: [chargeItemId], references: [id])
  taxCode         TaxCode?    @relation(fields: [taxCodeId], references: [id])
}

model Bill {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @db.Uuid
  branchId        String?             @db.Uuid
  number          String
  vendorId        String              @db.Uuid
  bookingId       String?             @db.Uuid
  shipmentId      String?             @db.Uuid
  customsFileId   String?             @db.Uuid
  declarationId   String?             @db.Uuid
  status          BillStatus          @default(DRAFT)
  issueDate       DateTime?
  dueDate         DateTime?
  currency        String              @default("EGP")
  exchangeRate    Decimal             @default(1) @db.Decimal(18, 8)
  subtotal        Decimal             @default(0) @db.Decimal(18, 2)
  discount        Decimal             @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal             @default(0) @db.Decimal(18, 2)
  total           Decimal             @default(0) @db.Decimal(18, 2)
  paidAmount      Decimal             @default(0) @db.Decimal(18, 2)
  balance         Decimal             @default(0) @db.Decimal(18, 2)
  vendorReference String?
  notes           String?             @db.Text
  postedEntryId   String?             @unique @db.Uuid
  createdById     String?
  version         Int                 @default(1)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  company         Company             @relation(fields: [companyId], references: [id])
  branch          Branch?             @relation(fields: [branchId], references: [id])
  vendor          BusinessPartner     @relation(fields: [vendorId], references: [id])
  booking         Booking?            @relation(fields: [bookingId], references: [id])
  shipment        Shipment?           @relation(fields: [shipmentId], references: [id])
  customsFile     CustomsFile?        @relation(fields: [customsFileId], references: [id])
  declaration     CustomsDeclaration? @relation(fields: [declarationId], references: [id])
  lines           BillLine[]
  allocations     PaymentAllocation[]
  journalLines    JournalLine[]       @relation("JournalBill")
  postedEntry     JournalEntry?       @relation("BillEntry", fields: [postedEntryId], references: [id])

  @@unique([companyId, number])
  @@index([companyId, status, dueDate])
}

model BillLine {
  id              String      @id @default(uuid()) @db.Uuid
  billId          String      @db.Uuid
  position        Int         @default(0)
  chargeItemId    String?     @db.Uuid
  description     String
  quantity        Decimal     @default(1) @db.Decimal(18, 3)
  unitPrice       Decimal     @db.Decimal(18, 2)
  discountPercent Decimal     @default(0) @db.Decimal(9, 4)
  taxCodeId       String?     @db.Uuid
  taxPercent      Decimal     @default(0) @db.Decimal(9, 4)
  subtotal        Decimal     @db.Decimal(18, 2)
  discount        Decimal     @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(18, 2)
  total           Decimal     @db.Decimal(18, 2)
  bill            Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  chargeItem      ChargeItem? @relation(fields: [chargeItemId], references: [id])
  taxCode         TaxCode?    @relation(fields: [taxCodeId], references: [id])
}

model JournalEntry {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  number          String
  journalId       String           @db.Uuid
  periodId        String           @db.Uuid
  entryDate       DateTime         @db.Date
  status          EntryStatus      @default(DRAFT)
  description     String
  sourceType      String?
  sourceId        String?
  currency        String           @default("EGP")
  exchangeRate    Decimal          @default(1) @db.Decimal(18, 8)
  totalDebit      Decimal          @default(0) @db.Decimal(18, 2)
  totalCredit     Decimal          @default(0) @db.Decimal(18, 2)
  postedAt        DateTime?
  postedById      String?
  reversedEntryId String?          @unique @db.Uuid
  createdById     String?
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id])
  journal         Journal          @relation(fields: [journalId], references: [id])
  period          AccountingPeriod @relation(fields: [periodId], references: [id])
  reversedEntry   JournalEntry?    @relation("Reversal", fields: [reversedEntryId], references: [id])
  reversals       JournalEntry[]   @relation("Reversal")
  lines           JournalLine[]
  invoice         Invoice?         @relation("InvoiceEntry")
  bill            Bill?            @relation("BillEntry")
  payment         Payment?         @relation("PaymentEntry")

  @@unique([companyId, number])
  @@index([companyId, entryDate, status])
}

model JournalLine {
  id                  String               @id @default(uuid()) @db.Uuid
  entryId             String               @db.Uuid
  accountId           String               @db.Uuid
  debit               Decimal              @default(0) @db.Decimal(18, 2)
  credit              Decimal              @default(0) @db.Decimal(18, 2)
  description         String?
  partnerId           String?              @db.Uuid
  invoiceId           String?              @db.Uuid
  billId              String?              @db.Uuid
  paymentId           String?              @db.Uuid
  entry               JournalEntry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account             Account              @relation(fields: [accountId], references: [id])
  partner             BusinessPartner?     @relation("JournalPartner", fields: [partnerId], references: [id])
  invoice             Invoice?             @relation("JournalInvoice", fields: [invoiceId], references: [id])
  bill                Bill?                @relation("JournalBill", fields: [billId], references: [id])
  payment             Payment?             @relation("JournalPayment", fields: [paymentId], references: [id])
  reconciliationItems ReconciliationItem[]
}

model BankAccount {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  code            String
  name            String
  accountId       String           @db.Uuid
  currency        String           @default("EGP")
  iban            String?
  bankName        String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id])
  account         Account          @relation(fields: [accountId], references: [id])
  payments        Payment[]
  reconciliations Reconciliation[]

  @@unique([companyId, code])
}

model Payment {
  id                  String               @id @default(uuid()) @db.Uuid
  companyId           String               @db.Uuid
  number              String
  direction           PaymentDirection
  partnerId           String               @db.Uuid
  method              PaymentMethod
  bankAccountId       String?              @db.Uuid
  paymentDate         DateTime             @db.Date
  currency            String               @default("EGP")
  exchangeRate        Decimal              @default(1) @db.Decimal(18, 8)
  amount              Decimal              @db.Decimal(18, 2)
  reference           String?
  status              PaymentStatus        @default(DRAFT)
  notes               String?              @db.Text
  postedEntryId       String?              @unique @db.Uuid
  createdById         String?
  postedById          String?
  postedAt            DateTime?
  version             Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  company             Company              @relation(fields: [companyId], references: [id])
  partner             BusinessPartner      @relation(fields: [partnerId], references: [id])
  bankAccount         BankAccount?         @relation(fields: [bankAccountId], references: [id])
  allocations         PaymentAllocation[]
  journalLines        JournalLine[]        @relation("JournalPayment")
  reconciliationItems ReconciliationItem[]
  postedEntry         JournalEntry?        @relation("PaymentEntry", fields: [postedEntryId], references: [id])

  @@unique([companyId, number])
  @@index([companyId, direction, paymentDate])
}

model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @db.Uuid
  invoiceId String?  @db.Uuid
  billId    String?  @db.Uuid
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  bill      Bill?    @relation(fields: [billId], references: [id])

  @@unique([paymentId, invoiceId])
  @@unique([paymentId, billId])
}

model Reconciliation {
  id             String               @id @default(uuid()) @db.Uuid
  companyId      String               @db.Uuid
  bankAccountId  String               @db.Uuid
  statementStart DateTime             @db.Date
  statementEnd   DateTime             @db.Date
  openingBalance Decimal              @db.Decimal(18, 2)
  closingBalance Decimal              @db.Decimal(18, 2)
  status         ReconciliationStatus @default(DRAFT)
  reviewedById   String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  company        Company              @relation(fields: [companyId], references: [id])
  bankAccount    BankAccount          @relation(fields: [bankAccountId], references: [id])
  items          ReconciliationItem[]

  @@index([companyId, bankAccountId, statementEnd])
}

model ReconciliationItem {
  id               String         @id @default(uuid()) @db.Uuid
  reconciliationId String         @db.Uuid
  statementDate    DateTime       @db.Date
  description      String
  amount           Decimal        @db.Decimal(18, 2)
  reference        String?
  matchStatus      MatchStatus    @default(UNMATCHED)
  paymentId        String?        @db.Uuid
  journalLineId    String?        @db.Uuid
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  payment          Payment?       @relation(fields: [paymentId], references: [id])
  journalLine      JournalLine?   @relation(fields: [journalLineId], references: [id])
}

model NumberSequence {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  key       String
  prefix    String
  year      Int
  current   Int      @default(0)
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, key, year])
}

model IdempotencyRecord {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  key       String
  response  Json
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model IntegrationRecord {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  provider    String
  type        String
  externalId  String?
  status      String
  requestHash String?
  response    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id])

  @@unique([provider, type, externalId])
  @@index([companyId, status, createdAt])
}
