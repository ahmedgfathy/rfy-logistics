}

model CustomsStatusEvent {
  id            String            @id @default(uuid()) @db.Uuid
  customsFileId String            @db.Uuid
  status        CustomsFileStatus
  description   String
  occurredAt    DateTime          @default(now())
  createdById   String?
  customsFile   CustomsFile       @relation(fields: [customsFileId], references: [id], onDelete: Cascade)
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @db.Uuid
  code          String
  nameEn        String
  nameAr        String?
  type          AccountType
  normalBalance NormalBalance
  parentId      String?       @db.Uuid
  systemCode    String?
  currency      String?
  isPostable    Boolean       @default(true)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id])
  parent        Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children      Account[]     @relation("AccountTree")
  journalLines  JournalLine[]
  bankAccounts  BankAccount[]
  taxCodes      TaxCode[]

  @@unique([companyId, code])
  @@index([companyId, type])
}

model Journal {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @db.Uuid
  code      String
  nameEn    String
  nameAr    String?
  type      JournalType
  isSystem  Boolean        @default(false)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   Company        @relation(fields: [companyId], references: [id])
  entries   JournalEntry[]

  @@unique([companyId, code])
}

model FiscalYear {
  id        String             @id @default(uuid()) @db.Uuid
  companyId String             @db.Uuid
  code      String
  nameEn    String
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
