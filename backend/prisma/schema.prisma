model DeclarationCharge {
  id            String             @id @default(uuid()) @db.Uuid
  declarationId String             @db.Uuid
  chargeItemId  String?            @db.Uuid
  label         String
  amount        Decimal            @db.Decimal(18, 2)
  currency      String             @default("EGP")
