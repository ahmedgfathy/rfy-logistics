{
  "name": "marsa-logistics-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the MARSA Logistics corporate website and admin dashboard",
  "main": "dist/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/db/seed.ts",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/modules/*/*.test.ts",
    "test:erp": "node scripts/erp-smoke.cjs",
    "test:accounting": "node scripts/accounting-smoke.cjs"
  },
  "prisma": {
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "prisma": "5.22.0",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.12.1",
    "multer": "2.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/multer": "2.3.0",
    "@types/node": "22.9.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
